# Public browser configuration only. Never use service_role or sb_secret_* here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Explicit opt-in for the old fictional Explorer catalogue; false by default.
VITE_DEMO_MODE=false
# Only needed when serving the optional platform shell on a separate origin:
VITE_EXPLORER_URL=http://localhost:5173/index.html#explorer
